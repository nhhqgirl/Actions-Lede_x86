# Target Config
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
# Firmware Size
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=960
# Compile
CONFIG_CCACHE=n
CONFIG_DEVEL=n
# ==================== 只生成 combined.img.gz ====================
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 关闭所有多余镜像格式
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

# ==================== 基础插件 ====================
CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-wol=y

# ==================== OpenClash 完整依赖 ====================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
# 禁用原版dnsmasq，使用dnsmasq‑full
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_libustream-openssl=y

# ==================== StrongSwan IKEv2 完整依赖【重点新增】 ====================
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-libcharon=y
CONFIG_PACKAGE_strongswan-starter=y
CONFIG_PACKAGE_strongswan-utils=y
# IKEv2核心插件
CONFIG_PACKAGE_strongswan-plugin-aes=y
CONFIG_PACKAGE_strongswan-plugin-attr=y
CONFIG_PACKAGE_strongswan-plugin-cert-enroll=y
CONFIG_PACKAGE_strongswan-plugin-constraints=y
CONFIG_PACKAGE_strongswan-plugin-curl=y
CONFIG_PACKAGE_strongswan-plugin-dhcp=y
CONFIG_PACKAGE_strongswan-plugin-eap-identity=y
CONFIG_PACKAGE_strongswan-plugin-eap-md5=y
CONFIG_PACKAGE_strongswan-plugin-eap-mschapv2=y
CONFIG_PACKAGE_strongswan-plugin-fips-prf=y
CONFIG_PACKAGE_strongswan-plugin-gcm=y
CONFIG_PACKAGE_strongswan-plugin-hmac=y
CONFIG_PACKAGE_strongswan-plugin-ipsec=y
CONFIG_PACKAGE_strongswan-plugin-kernel-netlink=y
CONFIG_PACKAGE_strongswan-plugin-md5=y
CONFIG_PACKAGE_strongswan-plugin-pem=y
CONFIG_PACKAGE_strongswan-plugin-pkcs1=y
CONFIG_PACKAGE_strongswan-plugin-pkcs8=y
CONFIG_PACKAGE_strongswan-plugin-pubkey=y
CONFIG_PACKAGE_strongswan-plugin-random=y
CONFIG_PACKAGE_strongswan-plugin-sha1=y
CONFIG_PACKAGE_strongswan-plugin-sha2=y
CONFIG_PACKAGE_strongswan-plugin-socket-default=y
CONFIG_PACKAGE_strongswan-plugin-sql=y
CONFIG_PACKAGE_strongswan-plugin-sqlite=y
CONFIG_PACKAGE_strongswan-plugin-x509=y
CONFIG_PACKAGE_strongswan-plugin-xauth-generic=y

# 内核IPsec/XFRM 加密模块（IKEv2必须）
CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-xfrm=y
CONFIG_PACKAGE_kmod-xfrm-interface=y
CONFIG_PACKAGE_kmod-xfrm-state=y
CONFIG_PACKAGE_kmod-xfrm-user=y
CONFIG_PACKAGE_kmod-netlink-diag=y

# ==================== 网络性能 ====================
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ixgbe=y

# ==================== 文件系统 + USB ====================
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y

# ==================== Samba4 完整 ====================
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_wsdd2=y

# ==================== IPv6 完整支持 ====================
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-nf-nat6=y

# ==================== 实用工具 ====================
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_openssh-sftp-server=y
# CONFIG_PACKAGE_vim-fuller is not set
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_tcpdump=y

# ==================== 主题 ====================
CONFIG_PACKAGE_luci-theme-argon=y

# ==================== 关闭无用插件（已全部屏蔽）====================
